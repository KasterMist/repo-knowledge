{
  "name": "repo-knowledge",
  "displayName": "Repo Knowledge",
  "description": "Shared knowledge retrieval and Codex MCP connection preview",
  "publisher": "KasterMist",
  "repository": {
    "type": "git",
    "url": "https://github.com/KasterMist/repo-knowledge.git"
  },
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "repoKnowledge.openWikiPreview",
        "title": "Repo Knowledge: Open Wiki Preview",
        "icon": "$(book)"
      },
      {
        "command": "repoKnowledge.openGenerationPanel",
        "title": "Repo Knowledge: Open Generation Panel",
        "icon": "$(sparkle)"
      },
      {
        "command": "repoKnowledge.openHome",
        "title": "Repo Knowledge: Open Knowledge Home",
        "icon": "$(home)"
      },
      {
        "command": "repoKnowledge.generateKnowledgeUpdate",
        "title": "Repo Knowledge: Generate Card Update"
      },
      {
        "command": "repoKnowledge.recoverIncrementalUpdate",
        "title": "Repo Knowledge: Recover Incremental Result"
      },
      {
        "command": "repoKnowledge.mergeProposal",
        "title": "Repo Knowledge: Merge Proposal into Draft"
      },
      {
        "command": "repoKnowledge.bindRepositoryContext",
        "title": "Repo Knowledge: Bind Repository Context"
      },
      {
        "command": "repoKnowledge.initialize",
        "title": "Repo Knowledge: Initialize External Store"
      },
      {
        "command": "repoKnowledge.openSnapshot",
        "title": "Repo Knowledge: Open Knowledge Snapshot"
      },
      {
        "command": "repoKnowledge.search",
        "title": "Repo Knowledge: Search Cards"
      },
      {
        "command": "repoKnowledge.codexSetup",
        "title": "Repo Knowledge: Show Codex MCP Setup"
      },
      {
        "command": "repoKnowledge.diagnostics",
        "title": "Repo Knowledge: Diagnose Standalone MCP"
      },
      {
        "command": "repoKnowledge.openDemo",
        "title": "Repo Knowledge: Open Three-Card Demo"
      },
      {
        "command": "repoKnowledge.openWorkbench",
        "title": "Repo Knowledge: Open Knowledge Workbench"
      },
      {
        "command": "repoKnowledge.refreshKnowledge",
        "title": "Repo Knowledge: Refresh Knowledge"
      },
      {
        "command": "repoKnowledge.openCard",
        "title": "Repo Knowledge: Open Card"
      },
      {
        "command": "repoKnowledge.openEvidence",
        "title": "Repo Knowledge: Open Source Evidence"
      },
      {
        "command": "repoKnowledge.editCard",
        "title": "Repo Knowledge: Edit Card Draft"
      },
      {
        "command": "repoKnowledge.openDraft",
        "title": "Repo Knowledge: Open Draft"
      },
      {
        "command": "repoKnowledge.submitDraft",
        "title": "Repo Knowledge: Submit Draft for Review"
      },
      {
        "command": "repoKnowledge.reviewProposal",
        "title": "Repo Knowledge: Review Proposal Diff"
      },
      {
        "command": "repoKnowledge.publishProposal",
        "title": "Repo Knowledge: Publish Reviewed Proposal"
      },
      {
        "command": "repoKnowledge.openHistory",
        "title": "Repo Knowledge: Open Publication History"
      },
      {
        "command": "repoKnowledge.rollbackKnowledge",
        "title": "Repo Knowledge: Roll Back Knowledge"
      },
      {
        "command": "repoKnowledge.recoverPublication",
        "title": "Repo Knowledge: Recover Publication Marker"
      },
      {
        "command": "repoKnowledge.planGeneration",
        "title": "Repo Knowledge: Plan Knowledge Generation"
      },
      {
        "command": "repoKnowledge.saveGenerationPlan",
        "title": "Repo Knowledge: Save Generation Plan"
      },
      {
        "command": "repoKnowledge.diagnoseGenerationBackend",
        "title": "Repo Knowledge: Diagnose Generation Backend"
      },
      {
        "command": "repoKnowledge.reviewCreation",
        "title": "Repo Knowledge: Review New Cards"
      },
      {
        "command": "repoKnowledge.publishCreation",
        "title": "Repo Knowledge: Publish Reviewed Creation"
      },
      {
        "command": "repoKnowledge.generateKnowledge",
        "title": "Repo Knowledge: Generate Knowledge Candidate"
      },
      {
        "command": "repoKnowledge.recoverGeneration",
        "title": "Repo Knowledge: Recover or Retry Generation Job"
      },
      {
        "command": "repoKnowledge.captureDependencyBaseline",
        "title": "Repo Knowledge: Capture Dependency Baseline"
      },
      {
        "command": "repoKnowledge.reviewKnowledgeChanges",
        "title": "Repo Knowledge: Review Knowledge Changes"
      },
      {
        "command": "repoKnowledge.openImpactTarget",
        "title": "Repo Knowledge: Open Impact Report Target"
      }
    ],
    "configuration": {
      "title": "Repo Knowledge",
      "properties": {
        "repoKnowledge.nodeExecutable": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "Node executable for standalone MCP. Native preview uses Node 24.19.x. On Remote SSH, the default node value uses the remote VS Code Server Node binary; an absolute remote Node path overrides it."
        },
        "repoKnowledge.storeDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Absolute directory containing knowledge.json. Empty uses per-repository extension storage outside the target repository."
        },
        "repoKnowledge.codexExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute host-side Codex executable for metadata diagnostics and explicitly confirmed generation. Empty tries the installed official extension on this host. Login/provider settings and tokens are not copied; a model turn is submitted only by explicit generation after source confirmation."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repoKnowledge",
          "title": "Repo Knowledge",
          "icon": "media/knowledge.svg"
        }
      ]
    },
    "views": {
      "repoKnowledge": [
        {
          "id": "repoKnowledge.wiki",
          "name": "Repo Wiki · 按源码范围"
        },
        {
          "id": "repoKnowledge.cards",
          "name": "知识卡片 · Cards"
        },
        {
          "id": "repoKnowledge.drafts",
          "name": "草稿 · Drafts"
        },
        {
          "id": "repoKnowledge.proposals",
          "name": "待审阅 · Proposals"
        },
        {
          "id": "repoKnowledge.creations",
          "name": "新增待审阅 · New Cards"
        },
        {
          "id": "repoKnowledge.history",
          "name": "发布历史 · History"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "repoKnowledge.openHome",
          "when": "view =~ /^repoKnowledge\\./",
          "group": "navigation@0"
        },
        {
          "command": "repoKnowledge.refreshKnowledge",
          "when": "view =~ /^repoKnowledge\\./",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "repoKnowledge.openCard",
          "when": "viewItem == knowledge-card",
          "group": "inline"
        },
        {
          "command": "repoKnowledge.editCard",
          "when": "viewItem == knowledge-card",
          "group": "knowledge"
        },
        {
          "command": "repoKnowledge.submitDraft",
          "when": "viewItem == knowledge-drafts",
          "group": "knowledge"
        },
        {
          "command": "repoKnowledge.publishProposal",
          "when": "viewItem == knowledge-proposals",
          "group": "knowledge"
        },
        {
          "command": "repoKnowledge.rollbackKnowledge",
          "when": "viewItem == knowledge-history",
          "group": "knowledge"
        },
        {
          "command": "repoKnowledge.recoverPublication",
          "when": "viewItem == knowledge-history",
          "group": "knowledge"
        },
        {
          "command": "repoKnowledge.planGeneration",
          "when": "viewItem == knowledge-repository",
          "group": "planning"
        },
        {
          "command": "repoKnowledge.saveGenerationPlan",
          "when": "viewItem == knowledge-repository",
          "group": "planning"
        },
        {
          "command": "repoKnowledge.diagnoseGenerationBackend",
          "when": "viewItem == knowledge-repository",
          "group": "planning"
        },
        {
          "command": "repoKnowledge.publishCreation",
          "when": "viewItem == knowledge-creations",
          "group": "knowledge"
        },
        {
          "command": "repoKnowledge.generateKnowledge",
          "when": "viewItem == knowledge-repository",
          "group": "planning"
        }
      ]
    }
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.2"
  },
  "dependencies": {
    "@repo-knowledge/core": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "marked": "18.1.1"
  }
}
