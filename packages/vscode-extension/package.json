{
  "name": "repo-knowledge",
  "displayName": "Repo Knowledge",
  "description": "Shared knowledge retrieval and Codex MCP connection preview",
  "publisher": "KasterMist",
  "repository": {
    "type": "git",
    "url": "https://github.com/KasterMist/repo-knowledge.git"
  },
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "repoKnowledge.initialize",
        "title": "Repo Knowledge: Initialize External Store"
      },
      {
        "command": "repoKnowledge.openSnapshot",
        "title": "Repo Knowledge: Open Knowledge Snapshot"
      },
      {
        "command": "repoKnowledge.search",
        "title": "Repo Knowledge: Search Cards"
      },
      {
        "command": "repoKnowledge.codexSetup",
        "title": "Repo Knowledge: Show Codex MCP Setup"
      },
      {
        "command": "repoKnowledge.diagnostics",
        "title": "Repo Knowledge: Diagnose Standalone MCP"
      },
      {
        "command": "repoKnowledge.openDemo",
        "title": "Repo Knowledge: Open Three-Card Demo"
      },
      {
        "command": "repoKnowledge.openWorkbench",
        "title": "Repo Knowledge: Open Knowledge Workbench"
      },
      {
        "command": "repoKnowledge.refreshKnowledge",
        "title": "Repo Knowledge: Refresh Knowledge"
      },
      {
        "command": "repoKnowledge.openCard",
        "title": "Repo Knowledge: Open Card"
      },
      {
        "command": "repoKnowledge.openEvidence",
        "title": "Repo Knowledge: Open Source Evidence"
      }
    ],
    "configuration": {
      "title": "Repo Knowledge",
      "properties": {
        "repoKnowledge.nodeExecutable": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "Node executable for standalone MCP. Native preview uses Node 24.19.x. On Remote SSH, the default node value uses the remote VS Code Server Node binary; an absolute remote Node path overrides it."
        },
        "repoKnowledge.storeDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Absolute directory containing knowledge.json. Empty uses per-repository extension storage outside the target repository."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repoKnowledge",
          "title": "Repo Knowledge",
          "icon": "media/knowledge.svg"
        }
      ]
    },
    "views": {
      "repoKnowledge": [
        {
          "id": "repoKnowledge.wiki",
          "name": "Repo Wiki \u00b7 \u6309\u6e90\u7801\u8303\u56f4"
        },
        {
          "id": "repoKnowledge.cards",
          "name": "\u77e5\u8bc6\u5361\u7247 \u00b7 Cards"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "repoKnowledge.refreshKnowledge",
          "when": "view == repoKnowledge.wiki || view == repoKnowledge.cards",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "repoKnowledge.openCard",
          "when": "viewItem == knowledge-card",
          "group": "inline"
        }
      ]
    }
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.2"
  },
  "dependencies": {
    "@repo-knowledge/core": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
